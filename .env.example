# Copy to .env and fill in. Never commit .env (it is gitignored).

# Which model backend the scoring engine uses: "anthropic" (default) or "ollama" (local).
MODEL_PROVIDER=anthropic

# --- Anthropic (used when MODEL_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Ollama (used when MODEL_PROVIDER=ollama; fully local, no external calls) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Path to the SQLite database file (relative to repo root).
DATABASE_PATH=data/console.db
